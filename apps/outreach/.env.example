# Copy to .env.local and export it before `npm start`, or pass these inline.
# Nothing here is required to run the demo — only to deliver real mail.

# ---- the operator ----------------------------------------------------------
OUTREACH_PASSWORD=            # required in production; dev default is "outreach"
OUTREACH_SECRET=              # signs unsubscribe links + the session cookie (32+ chars)

# ---- who the letters come from (these appear in the message) ----------------
OUTREACH_SENDER_NAME=Nuno
OUTREACH_SENDER_ROLE=Away
OUTREACH_FROM="Nuno at Away <nuno@away.app>"
OUTREACH_REPLY_TO=nuno@away.app
OUTREACH_POSTAL_ADDRESS="Away Lda, Rua da Prata 80, 1100-052 Lisboa, Portugal"

# ---- where links point -----------------------------------------------------
AWAY_APP_URL=https://away.app          # the product: /c/<city>, /partner
OUTREACH_PUBLIC_URL=https://outreach.away.app   # this tool, for /u/<token>

# ---- delivery --------------------------------------------------------------
OUTREACH_MAIL_TRANSPORT=file           # file | resend | http
RESEND_API_KEY=                        # needed for transport=resend
# OUTREACH_MAIL_URL=https://relay.internal/send   # for transport=http

# ---- limits ----------------------------------------------------------------
OUTREACH_DAILY_CAP=25
OUTREACH_WINDOW_START=8
OUTREACH_WINDOW_END=18
OUTREACH_TZ=Europe/Lisbon

# ---- the product, read-only (never cold-email an existing partner) ----------
# AWAY_DB_PATH=../web/data/away.db

# ---- crawling --------------------------------------------------------------
OUTREACH_HOST_DELAY_MS=1200            # between requests to the same host
OUTREACH_MAX_PAGES=3                   # homepage + up to two contact-ish pages
OUTREACH_RADIUS_M=9000                 # how far from the city centre to look
