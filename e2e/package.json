{
  "name": "away-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser clicks through Away \u2014 and the same walk-through also runs headless over HTTP, with no browser at all.",
  "scripts": {
    "pretest": "node ensure-build.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "browsers": "playwright install chromium",
    "smoke": "playwright test tests/00-smoke.spec.ts",
    "journey": "node run-journey.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0"
  }
}
